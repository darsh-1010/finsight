# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_5_MINI=gpt-5-mini
OPENAI_EMBEDD_MODEL_SMALL=text-embedding-3-small

# Weaviate Configuration (use localhost when running API locally, weaviate when in Docker)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051
WEAVIATE_API_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL_SECONDS=86400
SESSION_STATE_TTL_SECONDS=2592000
CHAT_HISTORY_TTL_SECONDS=259200
TICKER_CACHE_TTL_SECONDS=259200

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# RAG Configuration
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Thresholds (can be overridden via environment variables)
MIN_ARTICLE_RELEVANCE_SCORE=0.45
MIN_DOCUMENT_RELEVANCE_SCORE=0.40

# PDF Scraper Configuration
PDF_SCRAPER_TIMEOUT=30
PDF_MIN_CONTENT_LENGTH=300

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
S3_BUCKET_NAME=aimi-staging

# Scraper Lookback Settings (Days to fetch)
# (Interval should be <= Lookback to avoid missing data)
MAN_INST_LOOKBACK_DAYS=15
JEFFERIES_LOOKBACK_DAYS=45
MORGAN_STANLEY_LOOKBACK_DAYS=15
SCHWAB_LOOKBACK_DAYS=5
SEEKING_ALPHA_LOOKBACK_DAYS=10
ECONOMIC_TIMES_LOOKBACK_DAYS=10
BOFA_LOOKBACK_DAYS=10
INVESTING_COM_LOOKBACK_DAYS=10
BARRONS_LOOKBACK_DAYS=5
DEUTSCHE_BANK_LOOKBACK_DAYS=10
GOLDMANSACHS_LOOKBACK_DAYS=5
WEALTH_DB_LOOKBACK_DAYS=45

# Scraper Interval Settings (Frequency of runs)
# (Controls how many days to wait between successful scrapes)
MAN_INST_INTERVAL_DAYS=7
JEFFERIES_INTERVAL_DAYS=30
MORGAN_STANLEY_INTERVAL_DAYS=7
SCHWAB_INTERVAL_DAYS=1
SEEKING_ALPHA_INTERVAL_DAYS=1
ECONOMIC_TIMES_INTERVAL_DAYS=1
BOFA_INTERVAL_DAYS=1
INVESTING_COM_INTERVAL_DAYS=1
BARRONS_INTERVAL_DAYS=1
DEUTSCHE_BANK_INTERVAL_DAYS=7
GOLDMANSACHS_INTERVAL_DAYS=1
WEALTH_DB_INTERVAL_DAYS=30

# Scraper Execution Settings
SCRAPER_RUN_TIME=03:10 PM
SCRAPER_MAX_WORKERS=2

# Timezone for the scraper scheduler (IANA format)
SCRAPER_TIMEZONE=Asia/Kolkata

# Scraper Max Articles Configuration
MAN_INST_MAX_ARTICLES=50
JEFFERIES_MAX_ARTICLES=100
MORGAN_STANLEY_MAX_ARTICLES=200
SCHWAB_MAX_ARTICLES=50
SEEKING_ALPHA_MAX_ARTICLES=100
ECONOMIC_TIMES_MAX_ARTICLES=100
BOFA_MAX_ARTICLES=50
INVESTING_COM_MAX_ARTICLES=50
BARRONS_MAX_ARTICLES=50
DEUTSCHE_BANK_MAX_ARTICLES=50
GOLDMANSACHS_MAX_ARTICLES=50
WEALTH_DB_MAX_ARTICLES=50

# Backend service base URL for fetching live website ID↔name mappings.
# Set to the backend service URL (e.g. http://backend:8001) when deploying to pod server.
BACKEND_API_URL=

# ─── Chat History Backend Integration ──────────────────────────────────────────
# Base URL of the backend API that holds persistent chat history.
# Used by ChatHistoryService to hydrate sessions from the backend DB.
ML_DATA_TRANSFER_BASE_URL=https://api.chataimi.ai

# Secret token required by the backend's /api/v1/ml-data-transfer/ endpoints.
# Without this, chat history fetch is silently skipped.
ML_DATA_TRANSFER_TOKEN=your_ml_data_transfer_token_here

# Max number of past messages to retrieve from the backend per session (1–10).
MAX_MESSAGE_RETRIEVED=5

# Tier Daily Quotas
TIER_0_QUOTA=3
TIER_1_QUOTA=5
TIER_2_QUOTA=20
TIER_3_QUOTA=250
TIER_4_QUOTA=1000

# Tier Models (liteLLM format: e.g. openai/gpt-4, anthropic/claude-3-opus)
TIER_0_MODEL=gpt-4.1-mini
TIER_1_MODEL=gpt-4.1-mini
TIER_2_MODEL=gpt-4.1-mini
TIER_3_MODEL=gpt-4.1-mini
TIER_4_MODEL=gpt-4.1-mini

# Upload Guardrails
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_DOCUMENT_TOKENS=50000
TIER_3_MAX_DOCS_PER_SESSION=3
TIER_4_MAX_DOCS_PER_SESSION=5
TIER_3_MAX_FILES_PER_REQUEST=3
TIER_4_MAX_FILES_PER_REQUEST=8
TIER_3_MAX_UPLOAD_SIZE_BYTES=10485760
TIER_4_MAX_UPLOAD_SIZE_BYTES=20971520
TIER_3_MAX_DOCUMENT_TOKENS=35000
TIER_4_MAX_DOCUMENT_TOKENS=45000
TIER_3_TOKEN_BUDGET_RATIO=0.25
TIER_4_TOKEN_BUDGET_RATIO=0.35
