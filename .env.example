# ════════════════════════════════════════════════════════════════════════════
# [BACKEND] – p-finsight-be settings
# ════════════════════════════════════════════════════════════════════════════

PROJECT_NAME="FinSight AI"

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=finsight
POSTGRES_PORT=5432
# Optional: override the full URL directly (takes priority over individual fields)
# DATABASE_URL=postgresql://user:pass@host:port/db

# ── Auth / JWT ──────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost"]

# ── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_PRESIGNED_URL_EXPIRE_SECONDS=604800

# ── AWS SES (Email) ─────────────────────────────────────────────────────────
SES_SENDER_EMAIL=noreply@yourdomain.com
SES_REGION_NAME=us-east-1

# ── Frontend URL (used in emails / redirects) ───────────────────────────────
FRONTEND_URL=http://localhost:80

# ── ML Service URL (BE calls ML for chat) ───────────────────────────────────
# In Docker: use the container name  →  http://ml:8000
# In local dev: use localhost        →  http://localhost:8000
ML_API_URL=http://localhost:8000

# ── ML Data Transfer Token (shared secret between BE and ML) ────────────────
ML_SERVER_SECRET_TOKEN=change_this_to_a_secure_random_token

# ── BE Cron Settings ────────────────────────────────────────────────────────
CRON_INTERVAL_SECONDS=600
CRON_RUN_ON_START=True
CRON_INSIGHTS_SYNC_HOUR_IST=6
CRON_INSIGHTS_SYNC_MINUTE_IST=0
CRON_WEEKLY_INSIGHTS_SYNC_DAY=5


# ════════════════════════════════════════════════════════════════════════════
# [SHARED] – Redis (used by both backend and ml)
# ════════════════════════════════════════════════════════════════════════════

# Backend reads these individual fields:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ML reads the full URL:
REDIS_URL=redis://localhost:6379/0

REDIS_DEFAULT_TTL_SECONDS=86400
SESSION_STATE_TTL_SECONDS=2592000
CHAT_HISTORY_TTL_SECONDS=259200
TICKER_CACHE_TTL_SECONDS=259200


# ════════════════════════════════════════════════════════════════════════════
# [ML] – p-finsight-ml settings
# ════════════════════════════════════════════════════════════════════════════

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_5_MINI=gpt-4.1-mini
OPENAI_EMBEDD_MODEL_SMALL=text-embedding-3-small

# ── Weaviate Vector DB ───────────────────────────────────────────────────────
# In Docker: use the container name
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051
WEAVIATE_API_KEY=

# ── Application Settings ─────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ── RAG / Retrieval Config ───────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_ARTICLE_RELEVANCE_SCORE=0.45
MIN_DOCUMENT_RELEVANCE_SCORE=0.40

# ── PDF Scraper ───────────────────────────────────────────────────────────────
PDF_SCRAPER_TIMEOUT=30
PDF_MIN_CONTENT_LENGTH=300

# ── Chat History Backend Integration ─────────────────────────────────────────
# ML calls back to BE to fetch persistent chat history.
# In Docker: use the container name  →  http://backend:8001
# In local dev: use localhost        →  http://localhost:8001
ML_DATA_TRANSFER_BASE_URL=http://localhost:8001
ML_DATA_TRANSFER_TOKEN=change_this_to_a_secure_random_token

# ── Backend API URL (for scraper website ID mapping) ─────────────────────────
BACKEND_API_URL=http://localhost:8001

MAX_MESSAGE_RETRIEVED=5

# ── Tier Daily Quotas ─────────────────────────────────────────────────────────
ML_TIER_0_QUOTA=3
ML_TIER_1_QUOTA=5
ML_TIER_2_QUOTA=20
ML_TIER_3_QUOTA=250
ML_TIER_4_QUOTA=1000

# ── Tier Models (liteLLM format) ──────────────────────────────────────────────
ML_TIER_0_MODEL=gpt-4.1-mini
ML_TIER_1_MODEL=gpt-4.1-mini
ML_TIER_2_MODEL=gpt-4.1-mini
ML_TIER_3_MODEL=gpt-4.1-mini
ML_TIER_4_MODEL=gpt-4.1-mini
ML_TIER_5_MODEL=gpt-4.1-mini

# ── Upload Guardrails ─────────────────────────────────────────────────────────
ML_MAX_UPLOAD_SIZE_BYTES=20971520
ML_MAX_DOCUMENT_TOKENS=50000
ML_TIER_3_MAX_DOCS_PER_SESSION=3
ML_TIER_4_MAX_DOCS_PER_SESSION=5
ML_TIER_3_MAX_FILES_PER_REQUEST=3
ML_TIER_4_MAX_FILES_PER_REQUEST=8
TIER_3_ML_MAX_UPLOAD_SIZE_BYTES=10485760
TIER_4_ML_MAX_UPLOAD_SIZE_BYTES=20971520
TIER_3_ML_MAX_DOCUMENT_TOKENS=35000
TIER_4_ML_MAX_DOCUMENT_TOKENS=45000
ML_TIER_3_TOKEN_BUDGET_RATIO=0.25
ML_TIER_4_TOKEN_BUDGET_RATIO=0.35

# ── Scraper Lookback (days to fetch on each run) ──────────────────────────────
ML_SCRAPER_MAN_INST_LOOKBACK_DAYS=15
ML_SCRAPER_JEFFERIES_LOOKBACK_DAYS=45
ML_SCRAPER_MORGAN_STANLEY_LOOKBACK_DAYS=15
ML_SCRAPER_SCHWAB_LOOKBACK_DAYS=5
ML_SCRAPER_ECONOMIC_TIMES_LOOKBACK_DAYS=10
ML_SCRAPER_BOFA_LOOKBACK_DAYS=10
ML_SCRAPER_INVESTING_COM_LOOKBACK_DAYS=10
ML_SCRAPER_DEUTSCHE_BANK_LOOKBACK_DAYS=10
ML_SCRAPER_GOLDMANSACHS_LOOKBACK_DAYS=5
ML_SCRAPER_WEALTH_DB_LOOKBACK_DAYS=45

# ── Scraper Interval (days between runs) ─────────────────────────────────────
ML_SCRAPER_MAN_INST_INTERVAL_DAYS=7
ML_SCRAPER_JEFFERIES_INTERVAL_DAYS=30
ML_SCRAPER_MORGAN_STANLEY_INTERVAL_DAYS=7
ML_SCRAPER_SCHWAB_INTERVAL_DAYS=1
ML_SCRAPER_ECONOMIC_TIMES_INTERVAL_DAYS=1
ML_SCRAPER_BOFA_INTERVAL_DAYS=1
ML_SCRAPER_INVESTING_COM_INTERVAL_DAYS=1
ML_SCRAPER_DEUTSCHE_BANK_INTERVAL_DAYS=7
ML_SCRAPER_GOLDMANSACHS_INTERVAL_DAYS=1
ML_SCRAPER_WEALTH_DB_INTERVAL_DAYS=30

# ── Scraper Execution ─────────────────────────────────────────────────────────
ML_SCRAPER_RUN_TIME=03:10 PM
ML_SCRAPER_MAX_WORKERS=2
ML_SCRAPER_TIMEZONE=Asia/Kolkata

# ── Scraper Max Articles ──────────────────────────────────────────────────────
ML_SCRAPER_MAN_INST_MAX_ARTICLES=50
ML_SCRAPER_JEFFERIES_MAX_ARTICLES=100
ML_SCRAPER_MORGAN_STANLEY_MAX_ARTICLES=200
ML_SCRAPER_SCHWAB_MAX_ARTICLES=50
ML_SCRAPER_ECONOMIC_TIMES_MAX_ARTICLES=100
ML_SCRAPER_BOFA_MAX_ARTICLES=50
ML_SCRAPER_INVESTING_COM_MAX_ARTICLES=50
ML_SCRAPER_DEUTSCHE_BANK_MAX_ARTICLES=50
ML_SCRAPER_GOLDMANSACHS_MAX_ARTICLES=50
ML_SCRAPER_WEALTH_DB_MAX_ARTICLES=50


# ════════════════════════════════════════════════════════════════════════════
# [FRONTEND] – Vite build-time environment variables
# (These are baked into the JS bundle at build time)
# ════════════════════════════════════════════════════════════════════════════

# The base URL the browser uses to reach the BE API.
# In production: https://api.yourdomain.com/api/v1
# In local Docker: http://localhost:8001/api/v1
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Cookie name for visiting (trial) users
VITE_VISITING_USER_COOKIE_NAME=finsight_visiting_user
